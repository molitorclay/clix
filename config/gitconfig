[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
	line-numbers = true

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[init]
	defaultBranch = main

[color]
	ui = auto

[alias]
	co = checkout
	br = branch
	st = status
	ci = commit
	sw = switch
	lg = log --oneline --graph --decorate
	unstage = reset HEAD --
	last = log -1 HEAD
